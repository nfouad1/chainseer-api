FROM python:3.13-slim

ARG CYPHER_TEMPRE_COMMIT=963ee364718e369718a2d8b15754305ae28806c5
ARG CYPHER_TEMPRE_VERSION=3.30.08-tca.1

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    CHAINSEER_API_HOST=0.0.0.0 \
    CHAINSEER_CHAIN_ROOT=/data/chainseer_chain \
    CHAINSEER_SKILL_DIR=/opt/cypher-tempre-self-model \
    CHAINSEER_CYPHER_TEMPRE_COMMIT=${CYPHER_TEMPRE_COMMIT} \
    CHAINSEER_CYPHER_TEMPRE_VERSION=${CYPHER_TEMPRE_VERSION}

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Pin the MIT-licensed Cypher Tempre runtime so production analyses use the
# same reproducible Timechain implementation on every build. User chain data
# is never copied into the image; it lives only on the persistent /data disk.
ADD https://github.com/FrostedFlaming0/cypher-tempre-tcaFork/archive/${CYPHER_TEMPRE_COMMIT}.zip /tmp/cypher-tempre.zip
RUN python -m zipfile -e /tmp/cypher-tempre.zip /tmp/cypher-tempre \
    && cp -R \
      /tmp/cypher-tempre/cypher-tempre-tcaFork-${CYPHER_TEMPRE_COMMIT}/skills/codex/cypher-tempre-self-model \
      /opt/cypher-tempre-self-model \
    && rm -rf /tmp/cypher-tempre /tmp/cypher-tempre.zip \
    && test "$(cat /opt/cypher-tempre-self-model/VERSION)" = "${CYPHER_TEMPRE_VERSION}" \
    && test -f /opt/cypher-tempre-self-model/timechain.py \
    && test -f /opt/cypher-tempre-self-model/poq.py \
    && test -f /opt/cypher-tempre-self-model/recall.py \
    && test -f /opt/cypher-tempre-self-model/cambium.py \
    && test -f /opt/cypher-tempre-self-model/epochs.py \
    && test -f /opt/cypher-tempre-self-model/immune.py \
    && test -f /opt/cypher-tempre-self-model/modality_ops.py \
    && test -f /opt/cypher-tempre-self-model/registry/senses.json \
    && test -f /opt/cypher-tempre-self-model/registry/modalities.json

COPY chainseer.py chainseer_controls.py chainseer_deferred.py chainseer_job_store.py chainseer_base_public.py \
    chainseer_solana_public.py chainseer_benchmark.py \
    chainseer_entity_graph.py chainseer_governance.py \
    chainseer_outcome_ledger.py chainseer_temporal_graph.py \
    chainseer_memory.py \
    chainseer_alerts.py chainseer_core.py \
    chainseer_pumpfun_provenance.py chainseer_meteora_provenance.py \
    chainseer_wallet_convergence.py chainseer_api.py ./
COPY faculties/chainseer-production-v1.json \
    /app/faculties/chainseer-production-v1.json

RUN useradd --create-home --uid 10001 chainseer \
    && mkdir -p /data/chainseer_chain \
    && chown -R chainseer:chainseer /app /data \
    && chmod -R a-w /opt/cypher-tempre-self-model

USER chainseer

EXPOSE 8000
VOLUME ["/data"]

CMD ["python", "-X", "utf8", "chainseer_api.py"]
