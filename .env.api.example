CHAINSEER_ENVIRONMENT=development
CHAINSEER_API_HOST=127.0.0.1
CHAINSEER_API_PORT=8000
CHAINSEER_API_TOKEN=replace-with-at-least-32-random-characters
CHAINSEER_RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAINSEER_CHAIN_ROOT=./chainseer_chain
CHAINSEER_SKILL_DIR=C:/Users/your-user/.codex/skills/cypher-tempre-self-model
CHAINSEER_ALLOWED_ORIGINS=http://localhost:3000
CHAINSEER_ALLOWED_HOSTS=localhost,127.0.0.1
CHAINSEER_MAX_REQUEST_BYTES=2048
CHAINSEER_QUEUE_SIZE=20
CHAINSEER_RESULT_TTL_SECONDS=3600
CHAINSEER_SCAN_CACHE_TTL_SECONDS=300
CHAINSEER_RATE_LIMIT_PER_MINUTE=6
CHAINSEER_SHUTDOWN_GRACE_SECONDS=180
